flowchart LR
  subgraph Browser["botbench.neorgon.com (static, no backend)"]
    CAT[catalog.js<br/>hubs, devices, kits] --> BUILD[build.js<br/>ports, validation, matrix]
    BUILD --> SIM[sim.js + simview.js<br/>arena, kinematics, sensors,<br/>virtual hub]
    BRAIN[brain.js<br/>rules, modes, facts,<br/>local stand-in] --> SIM
    BUILD --> EXP[export.js]
    BRAIN --> EXP
    PROJ[projects.js + models.js<br/>ladder, models, ideas] --> SIM
    LINK[link.js + linkpanel.js<br/>Pybricks BLE profile,<br/>teleop, modes, decider]
    SIM <-->|facts, bytes| LINK
  end
  EXP -->|hub program .py via Pybricks Code| HUB[Robot Inventor Hub<br/>or EV3, Pybricks]
  EXP -->|bridge.py| BR[Laptop bridge<br/>API key lives here]
  LINK <-->|Web Bluetooth:<br/>facts out, mode and teleop bytes in| HUB
  HUB -->|facts over BLE, 2 Hz| BR
  BR -->|POST /v1/systemone| JEV[TypeSafe Jev]
  JEV -->|choice + confidence| BR
  BR -->|mode byte, if above gate| HUB
